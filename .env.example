# Port the Express server listens on. Most PaaS providers (Render, Railway,
# Hostinger) inject this automatically — only set it yourself on a VPS.
PORT=3000

# Gmail account used to send contact-form notifications.
# Use a Google App Password (not your regular password) - see README.
EMAIL_USER=
EMAIL_PASS=

# Optional. Comma-separated list of origins allowed to call /api/send-mail
# from a different domain. Leave unset if the frontend and API are served
# from this same app (the default) - CORS does not apply to same-origin calls.
# Example: CORS_ORIGIN=https://dppowersolutions.com,https://www.dppowersolutions.com
CORS_ORIGIN=https://dppowersolution.com
